# Local MongoDB connection string. Use a hosted database URI when deploying.
MONGODB_URI=mongodb://127.0.0.1:27017/akili_afya

# Port for local development. Render sets PORT automatically.
PORT=5000

# Allowed frontend origin(s), comma-separated. Set this on Render.
FRONTEND_ORIGIN=http://localhost:5173

# Generate a random secret of at least 32 characters for signing login tokens.
AUTH_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters
